# ==============================================================================
# Next Level Cheat - Backend Environment Configuration
# ==============================================================================

PROJECT_NAME="Next Level Cheat API"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL for Local & VPS)
# When deploying on VPS with Docker Compose, postgres hostname is used:
# DATABASE_URL=postgresql+asyncpg://postgres:nlc_db_password_2026@postgres:5432/nextlevelcheat_db
DATABASE_URL=postgresql+asyncpg://postgres:xivam@localhost:5432/nextlevelcheat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=xivam
POSTGRES_DB=nextlevelcheat

# If PostgreSQL is not currently running locally, enable SQLite fallback for instant zero-dependency testing
FALLBACK_TO_SQLITE=True

# High Security JWT Secret Key (Generate with: openssl rand -hex 32)
SECRET_KEY=9f8c6e2a5d4b1a7f0e3c8b5d2a9f4e1c7b0a3d6f9e2c5b8a1f4d7e0c3b6a9f2e
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Anti-Brute Force Login Security
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
MAX_LOGIN_REQUESTS_PER_WINDOW=10

# Default Initial Administrator (Auto-provisioned safely on first boot if no admin exists)
FIRST_SUPERADMIN_USERNAME=admin
FIRST_SUPERADMIN_PASSWORD=NextLevelAdmin@2026!

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000
